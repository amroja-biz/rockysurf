{
  "name": "@rockysurf/provider-aws",
  "version": "0.1.0",
  "description": "AWS EC2 compute provider — plain RunInstances, no CloudFormation.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amroja-biz/rockysurf.git",
    "directory": "packages/provider-aws"
  },
  "bugs": "https://github.com/amroja-biz/rockysurf/issues",
  "homepage": "https://github.com/amroja-biz/rockysurf/tree/main/packages/provider-aws#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-ec2": "^3.1108.0",
    "@aws-sdk/client-ssm": "^3.1108.0",
    "@rockysurf/provider-sdk": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@rockysurf/provider-conformance": "workspace:*",
    "@types/node": "^24.10.1",
    "aws-sdk-client-mock": "^4.1.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "rockysurf",
    "provider",
    "aws",
    "ec2"
  ]
}
