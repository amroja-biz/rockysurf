{
  "name": "rockysurf",
  "version": "0.1.0",
  "description": "Self-hosted persistent cloud dev boxes for coding agents. The composition root: wires the compute providers into the control plane.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "rockysurf": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amroja-biz/rockysurf.git",
    "directory": "packages/rockysurf"
  },
  "bugs": "https://github.com/amroja-biz/rockysurf/issues",
  "homepage": "https://github.com/amroja-biz/rockysurf#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@rockysurf/core": "workspace:*",
    "@rockysurf/provider-aws": "workspace:*",
    "@rockysurf/provider-azure": "workspace:*",
    "@rockysurf/provider-byo": "workspace:*",
    "@rockysurf/provider-gcp": "workspace:*",
    "@rockysurf/provider-hetzner": "workspace:*",
    "@rockysurf/provider-sdk": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "rockysurf",
    "cloud",
    "development",
    "claude-code"
  ]
}
