{
  "name": "@rockysurf/core",
  "version": "0.1.0",
  "description": "The portable control plane: Hono + Drizzle/SQLite + SSE + in-process jobs, with the web build bundled in.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "drizzle",
    "bootstrap",
    "packs",
    "public",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amroja-biz/rockysurf.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/amroja-biz/rockysurf/issues",
  "homepage": "https://github.com/amroja-biz/rockysurf/tree/main/packages/core#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/sync-packs-bundle.mjs && node ../../scripts/build-package.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "smoke:push": "tsx scripts/push-smoke.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "@hono/zod-validator": "^0.9.0",
    "@rockysurf/provider-sdk": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.1",
    "ssh2": "^1.17.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@rockysurf/provider-conformance": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.10.1",
    "@types/ssh2": "^1.15.5",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "rockysurf",
    "control-plane",
    "self-hosted",
    "coding-agents"
  ]
}
