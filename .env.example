# Rocky Surf environment — copy to `.env` and fill in.
#
#   cp .env.example .env
#
# `rockysurf.config.yaml` refers to these as ${VAR}, so nothing secret has to live in the
# config file itself. Load them however you like:
#
#   set -a; . ./.env; set +a
#
# `.env` is gitignored. Never commit real tokens.

# --- referenced by rockysurf.config.example.yaml ------------------------------------------

# Hetzner Cloud API token, read/write, from console.hetzner.cloud → your project →
# Security → API tokens. Required while `providers.hetzner.enabled` is true.
HETZNER_TOKEN=

# GitHub personal access token, `repo` scope. Only needed to clone PRIVATE repositories onto
# your boxes; public repos need nothing. Referenced by the commented `github.pat` line.
GITHUB_PAT=

# --- read directly by Rocky Surf, not through the config file -----------------------------

# Master key for the encrypted secrets in the database. Leave unset and one is generated at
# `<dataDir>/secret.key` on first run — back that file up, because losing it means losing
# every stored credential and the SSH keys for your existing boxes.
# Generate one with: openssl rand -hex 32
# ROCKYSURF_SECRET_KEY=

# --- AWS, when providers.aws.enabled is true ----------------------------------------------

# AWS credentials are resolved through the standard SDK chain, so set whichever you already
# use. Rocky Surf never reads AWS keys out of the config file.
# AWS_PROFILE=default
# AWS_REGION=us-east-1
